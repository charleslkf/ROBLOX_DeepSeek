{
  "name": "DNF-DS_MVP",
  "servePort": 55658,
  "tree": {
    "$className": "DataModel",
    "ReplicatedFirst": {
      "$path": "ReplicatedFirst"
    },
    "ReplicatedStorage": {
      "$path": "ReplicatedStorage"
    },
    "ServerScriptService": {
      "$path": "ServerScriptService"
    },
    "ServerStorage": {
      "$path": "ServerStorage"
    },
    "StarterGui": {
      "$path": "StarterGui"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$path": "StarterPlayer/StarterPlayerScripts"
      },
      "StarterCharacterScripts": {
        "$path": "StarterPlayer/StarterCharacterScripts"
      }
    },
    "Workspace": {
      "$path": "Workspace",
      "$ignore": [
        "Terrain"
      ]
    }
  }
}
